{
  "name": "cognitive-operating-system",
  "version": "2.1.0",
  "private": true,
  "description": "COS Graph Engine — Production-grade graph engine with CSR, WASM, pruning, observability, visualization, and deployment",
  "workspaces": [
    "packages/core",
    "packages/runtime",
    "packages/memory",
    "packages/knowledge",
    "packages/cognition",
    "packages/execution",
    "packages/orchestration",
    "packages/observability",
    "packages/api",
    "packages/infrastructure",
    "packages/deployment",
    "packages/graph",
    "packages/visualization",
    "packages/wasm"
  ],
  "scripts": {
    "asbuild": "cd packages/wasm && npx asc assembly/index.ts --outFile build/optimized.wasm --optimizeLevel 3 --shrinkLevel 1 --exportRuntime",
    "wasm:build": "npm run asbuild",
    "test": "tsx scripts/run-tests.ts",
    "test:all": "tsx scripts/run-tests.ts && tsx scripts/test-level1-diamond.ts && tsx scripts/test-level1-mutation.ts && tsx scripts/test-level3-consistency.ts && tsx scripts/test-level3-mutation.ts && tsx scripts/test-level7-compute.ts && tsx scripts/test-levels-12-19.ts && tsx scripts/test-pipeline-l45l6.ts && tsx scripts/test-pipeline-l891011.ts && tsx scripts/test-pipeline-l12131415.ts && tsx scripts/test-pipeline-l16171819.ts && tsx scripts/test-cli-visualizer.ts",
    "test:csr": "tsx scripts/test-csr.ts",
    "test:pruning": "tsx scripts/test-pruning.ts",
    "test:benchmark": "tsx scripts/test-benchmark.ts",
    "test:wasm": "tsx scripts/test-wasm.ts",
    "test:observability": "tsx packages/observability/tests/tracing.test.ts && tsx packages/observability/tests/collector.test.ts && tsx packages/observability/tests/profiler.test.ts && tsx packages/observability/tests/dashboard.test.ts",
    "test:visualization": "tsx packages/visualization/tests/svg-renderer.test.ts && tsx packages/visualization/tests/canvas-renderer.test.ts && tsx packages/visualization/tests/web-component.test.ts",
    "test:l1": "tsx scripts/test-level1-diamond.ts && tsx scripts/test-level1-mutation.ts",
    "test:l3": "tsx scripts/test-level3-consistency.ts && tsx scripts/test-level3-mutation.ts",
    "test:l7": "tsx scripts/test-level7-compute.ts",
    "test:mutation": "tsx scripts/test-level1-mutation.ts && tsx scripts/test-level3-mutation.ts",
    "benchmark": "tsx scripts/benchmark-perf.ts",
    "benchmark:report": "tsx scripts/benchmark-perf.ts && tsx scripts/generate-benchmark-report.ts",
    "benchmark:wasm": "tsx scripts/benchmark-wasm.ts",
    "coverage": "c8 npm run test:all 2>&1",
    "docs:api": "typedoc",
    "ci": "npm run test:all 2>&1",
    "build": "bash scripts/build.sh",
    "cos": "tsx packages/deployment/src/commander.ts",
    "cos:cli": "tsx packages/deployment/src/cli.ts",
    "cos:graph": "tsx packages/graph/src/cli.ts",
    "cos:visualizer": "tsx packages/graph/src/visualizer.ts",
    "help": "tsx packages/deployment/src/cli.ts --help",
    "release": "npm run build && echo 'Ready for npm publish'",
    "publish:graph": "cd packages/graph && npm publish --access public",
    "publish:observability": "cd packages/observability && npm publish --access public",
    "publish:visualization": "cd packages/visualization && npm publish --access public",
    "publish:wasm": "cd packages/wasm && npm publish --access public",
    "publish:all": "npm run publish:graph && npm run publish:observability && npm run publish:visualization && npm run publish:wasm",
    "version:patch": "node scripts/version-bump.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "assemblyscript": "0.28.20",
    "c8": "12.0.0",
    "md-to-pdf": "5.2.5",
    "pdfkit": "0.19.1",
    "tsx": "4.23.13",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotprods/cos-graph-engine.git"
  },
  "keywords": ["graph", "cos", "graph-engine", "csr", "wasm", "visualization", "observability"],
  "license": "MIT"
}
