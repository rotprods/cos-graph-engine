#!/bin/bash
# Pre-commit hook — verifica build + QA antes de cada commit.
# Instalación: git config core.hooksPath .githooks
# Si falla, el commit se cancela y hay que pushear igual los cambios parciales.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}=== PRE-COMMIT: Verificando build...${NC}"

# 1. Verificar que no hay archivos corruptos (syntax check)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' || true)
if [ -n "$STAGED_FILES" ]; then
  for f in $STAGED_FILES; do
    if [ -f "$f" ]; then
      node --check "$f" 2>/dev/null || {
        echo -e "${RED}❌ ERROR DE SINTAXIS en $f${NC}"
        node --check "$f"
        exit 1
      }
    fi
  done
  echo -e "${GREEN}  ✅ Syntax check: ${NC}$(echo "$STAGED_FILES" | wc -l) archivos OK"
fi

# 2. Build check
if ! npm run build 2>/dev/null | tail -1 | grep -q "built in"; then
  echo -e "${RED}❌ BUILD FALLÓ — commit cancelado.${NC}"
  echo "   Arregla el error, ejecuta 'git add' otra vez, y reintenta."
  exit 1
fi
echo -e "${GREEN}  ✅ Build: OK${NC}"

# 3. QA quick check (si existe)
if [ -f tools/qa-100percent.mjs ]; then
  if ! node tools/qa-100percent.mjs --quick 2>&1 | grep -q "Fail.*: 0"; then
    echo -e "${RED}❌ QA FALLÓ — commit cancelado.${NC}"
    echo "   Ejecuta 'node tools/qa-100percent.mjs' para ver detalles."
    exit 1
  fi
  echo -e "${GREEN}  ✅ QA: OK${NC}"
fi

echo -e "${GREEN}=== PRE-COMMIT: TODO OK. Commit permitido. ===${NC}"
exit 0