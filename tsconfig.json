{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@cos/core": ["./packages/core/src"],
      "@cos/runtime": ["./packages/runtime/src"],
      "@cos/memory": ["./packages/memory/src"],
      "@cos/knowledge": ["./packages/knowledge/src"],
      "@cos/cognition": ["./packages/cognition/src"],
      "@cos/execution": ["./packages/execution/src"],
      "@cos/orchestration": ["./packages/orchestration/src"],
      "@cos/observability": ["./packages/observability/src"],
      "@cos/telemetry": ["./packages/observability/src"],
      "@cos/api": ["./packages/api/src"],
      "@cos/infrastructure": ["./packages/infrastructure/src"],
      "@cos/deployment": ["./packages/deployment/src"],
      "@cos/graph": ["./packages/graph/src"],
      "@cos/visualization": ["./packages/visualization/src"],
      "@cos/wasm": ["./packages/wasm/src"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/runtime/src/**/*.ts",
    "packages/memory/src/**/*.ts",
    "packages/knowledge/src/**/*.ts",
    "packages/cognition/src/**/*.ts",
    "packages/execution/src/**/*.ts",
    "packages/orchestration/src/**/*.ts",
    "packages/observability/src/**/*.ts",
    "packages/api/src/**/*.ts",
    "packages/infrastructure/src/**/*.ts",
    "packages/deployment/src/**/*.ts",
    "packages/graph/src/**/*.ts",
    "packages/visualization/src/**/*.ts",
    "packages/wasm/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/build/**",
    "packages/wasm/assembly/**"
  ]
}
