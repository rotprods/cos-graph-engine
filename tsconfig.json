{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "packages/wasm/assembly/**"
  ]
}